{
  "name": "recommand-framework",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "test": "bun test ./test/*.test.ts",
    "dev": "concurrently \"bun run server:dev\" \"bun run app:dev\"",
    "build": "bun run app:build",
    "serve": "bun run server:prod",
    "server:dev": "NODE_ENV=development bun run --hot index.ts",
    "server:prod": "NODE_ENV=production bun run index.ts",
    "db:generate": "drizzle-kit generate",
    "app:dev": "NODE_ENV=development vite",
    "app:build": "NODE_ENV=production bun run typecheck && vite build",
    "typecheck": "bun run scripts/typecheck.ts",
    "translations:analyze": "bun run scripts/analyze-translations.ts",
    "app:preview": "NODE_ENV=production vite preview",
    "init-package": "bun run scripts/init-package.ts",
    "rm-package": "bun run scripts/rm-package.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^2.2.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.11",
    "vite": "^6.4.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@scalar/hono-api-reference": "^0.12.12",
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "hono-openapi": "^0.4.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ulid": "^2.4.0",
    "zod": "^3.25.76",
    "zod-openapi": "^4.2.4"
  }
}
